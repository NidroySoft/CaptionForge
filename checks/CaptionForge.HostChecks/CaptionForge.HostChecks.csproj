<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
 <ItemGroup><ProjectReference Include="../../src/CaptionForge.Desktop/CaptionForge.Desktop.csproj" /></ItemGroup>
 <Target Name="CopyInstalledModules" AfterTargets="Build">
  <ItemGroup><InstalledModuleFiles Include="../../artifacts/modules/**/*" /></ItemGroup>
  <Copy SourceFiles="@(InstalledModuleFiles)" DestinationFiles="@(InstalledModuleFiles->'$(TargetDir)Modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
 </Target>
</Project>
