<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptionForge.Desktop.Views.HelpWindow" Title="{DynamicResource Loc.help.title}" Style="{StaticResource AppWindow}" Width="710" Height="670" MinWidth="400" MinHeight="340" WindowStartupLocation="CenterOwner" Icon="../Resources/CaptionForge.ico"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Loc.help.heading}" Style="{StaticResource Section}"/><TextBlock Text="{DynamicResource Loc.help.summary}" Style="{StaticResource Muted}" Margin="0,0,0,12"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.projects.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.projects.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.audio.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.audio.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.template.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.template.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.generate.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.generate.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.apply.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.apply.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.backups.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.backups.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.settings.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.settings.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><Expander Header="{DynamicResource Loc.help.diagnostics.title}" Margin="0"><TextBlock Text="{DynamicResource Loc.help.diagnostics.body}" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander></Border></StackPanel></ScrollViewer><WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{DynamicResource Loc.help.start}" Click="StartFull" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/><Button x:Name="NewButton" Content="{DynamicResource Loc.help.new}" Click="StartNew" Margin="0,0,8,6"/><Button Content="{DynamicResource Loc.help.close}" Click="CloseHelp" Margin="0,0,0,6"/></WrapPanel></Grid></Window>