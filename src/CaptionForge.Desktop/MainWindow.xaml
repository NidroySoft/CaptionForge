<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:CaptionForge.Desktop.Views" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" xmlns:g="clr-namespace:CaptionForge.Desktop.Guidance" x:Class="CaptionForge.Desktop.MainWindow" Title="CaptionForge" Icon="Resources/CaptionForge.ico" Style="{StaticResource AppWindow}" Width="1080" Height="740" MinWidth="860" MinHeight="600" WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" SizeToContent="Manual">
  <Grid x:Name="ModuleContainer">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="20,12,20,0">
      <TextBlock Text="Herramientas" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Grid Width="280" HorizontalAlignment="Left">
        <ComboBox x:Name="ModuleSelector" DisplayMemberPath="DisplayName" SelectionChanged="ModuleChanged" AutomationProperties.Name="Abrir herramienta de CaptionForge"/>
        <TextBlock Text="+ Abrir herramienta…" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </DockPanel>
    <TabControl x:Name="ModuleTabs" Grid.Row="1" Margin="20,10,20,0" SelectionChanged="TabChanged" AutomationProperties.Name="Herramientas abiertas">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True" Background="Transparent"/></ControlTemplate></TabControl.Template>
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7,7,0,0" Padding="12,5" Margin="0,0,6,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </TabControl.Resources>
    </TabControl>
    <ContentControl x:Name="ModuleHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <TextBlock x:Name="EmptyModules" Grid.Row="2" Text="Abre una herramienta para comenzar." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
  <Grid x:Name="RootLayout" Grid.Row="2" Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Image Source="Resources/CaptionForge.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.ui.logoDeCaptionforge}"/>
        <StackPanel Margin="12,0,0,0">
          <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="Caption"/><Run Text="Forge" Foreground="{DynamicResource BrandTextBrush}"/></TextBlock>
          <TextBlock Text="{DynamicResource Loc.ui.subtitulosParaTusProyectosDeCapcut}" Style="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
      <Button g:TutorialTarget.Id="settings.open" DockPanel.Dock="Right" Content="⚙" Click="OpenSettings" ToolTip="{DynamicResource Loc.ui.configuracionDeLaAplicacion}" AutomationProperties.Name="{DynamicResource Loc.ui.configuracionDeLaAplicacion}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,5" MinHeight="32"/>
      <Button DockPanel.Dock="Right" Content="?" Click="OpenHelp" ToolTip="{DynamicResource Loc.ui.ayudaYTutorial}" AutomationProperties.Name="{DynamicResource Loc.ui.ayudaYTutorial}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,5" MinHeight="32"/>
      <Button DockPanel.Dock="Right" Content="{Binding Appearance.ToggleLabel}" Command="{Binding Appearance.ToggleTheme}" ToolTip="{Binding Appearance.ToggleHint}" VerticalAlignment="Center" Margin="14,0,0,0" Padding="10,5" MinHeight="32" AutomationProperties.Name="{DynamicResource Loc.ui.cambiarEntreTemaClaroYOscuro}"/>
      <TextBlock Text="{Binding SelectedSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}" TextWrapping="NoWrap" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="18,0,0,0"/>
    </DockPanel>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,16">
      <Button Content="{DynamicResource Loc.ui.1Proyecto}" Command="{Binding Navigate}" CommandParameter="0" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="0">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="{DynamicResource Loc.ui.2Timeline}" Command="{Binding Navigate}" CommandParameter="1" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="1">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="{DynamicResource Loc.ui.3AudioYPlantilla}" Command="{Binding Navigate}" CommandParameter="2" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="2">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="{DynamicResource Loc.ui.4Resultado}" Command="{Binding Navigate}" CommandParameter="3">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="3">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </UniformGrid>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="3" IsEnabled="{Binding IsIdle}">
      <v:ProjectsView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=0}"/>
      <v:TimelinesView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=1}"/>
      <v:ConfigurationView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=2}"/>
      <v:ResultsView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=3}"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Message}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Message}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="{DynamicResource Loc.ui.atras}" Command="{Binding Back}"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="16,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="{DynamicResource Loc.ui.cancelar}" Command="{Binding Cancel}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0"/>
        <Button Grid.Column="3" Content="{Binding NextLabel}" Command="{Binding Next}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="2">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Step}" Value="3">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </Grid>
    <c:TutorialOverlay x:Name="TutorialLayer" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="100" Visibility="Collapsed"/>
  </Grid>
  </Grid>
</Window>
