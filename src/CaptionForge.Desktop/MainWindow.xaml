<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:CaptionForge.Desktop.Views" x:Class="CaptionForge.Desktop.MainWindow" Title="CaptionForge" Icon="Resources/CaptionForge.ico" Style="{StaticResource AppWindow}" Width="1080" Height="740" MinWidth="860" MinHeight="600" WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" SizeToContent="Manual">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Image Source="Resources/CaptionForge.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Logo de CaptionForge"/>
        <StackPanel Margin="12,0,0,0">
          <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="Caption"/><Run Text="Forge" Foreground="{DynamicResource BrandTextBrush}"/></TextBlock>
          <TextBlock Text="Subtítulos para tus proyectos de CapCut" Style="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="{Binding Appearance.ToggleLabel}" Command="{Binding Appearance.ToggleTheme}" ToolTip="{Binding Appearance.ToggleHint}" VerticalAlignment="Center" Margin="14,0,0,0" Padding="10,5" MinHeight="32" AutomationProperties.Name="Cambiar entre tema claro y oscuro"/>
      <TextBlock Text="{Binding SelectedSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}" TextWrapping="NoWrap" MaxWidth="290" TextTrimming="CharacterEllipsis" Margin="18,0,0,0"/>
    </DockPanel>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,16">
      <Button Content="1   Proyecto" Command="{Binding Navigate}" CommandParameter="0" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="0">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="2   Timeline" Command="{Binding Navigate}" CommandParameter="1" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="1">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="3   Audio y plantilla" Command="{Binding Navigate}" CommandParameter="2" Margin="0,0,10,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="2">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="4   Resultado" Command="{Binding Navigate}" CommandParameter="3">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="3">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </UniformGrid>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="3" IsEnabled="{Binding IsIdle}">
      <v:ProjectsView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=0}"/>
      <v:TimelinesView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=1}"/>
      <v:ConfigurationView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=2}"/>
      <v:ResultsView Visibility="{Binding Step,Converter={StaticResource StepVisibility},ConverterParameter=3}"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Message}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Message}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="← Atrás" Command="{Binding Back}"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="16,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Cancelar" Command="{Binding Cancel}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0"/>
        <Button Grid.Column="3" Content="{Binding NextLabel}" Command="{Binding Next}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="2">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Step}" Value="3">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
