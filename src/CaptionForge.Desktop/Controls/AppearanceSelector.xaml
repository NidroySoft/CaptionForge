<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptionForge.Desktop.Controls.AppearanceSelector">
  <StackPanel DataContext="{Binding Appearance}">
    <TextBlock Text="{DynamicResource Loc.ui.apariencia}" Style="{StaticResource Section}" Margin="0,0,0,8"/>
    <CheckBox Content="{DynamicResource Loc.ui.usarElTemaDelSistema}" IsChecked="{Binding FollowSystem,Mode=TwoWay}" ToolTip="{DynamicResource Loc.ui.sigueElModoClaroUOscuroDeWindows}"/>
    <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
    <TextBlock Text="{DynamicResource Loc.ui.paletaDeColores}" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding AvailablePalettes}" SelectedItem="{Binding SelectedPalette,Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.ui.paletaDeColoresCompatibleConElModoActual}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{DynamicResource Loc.ui.soloSeMuestranLasPaletasCompatiblesConElModo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding PreferenceNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
</UserControl>
