<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptionForge.Desktop.Controls.TutorialOverlay" Focusable="False">
  <Canvas x:Name="Surface" Background="{x:Null}">
    <Border x:Name="Highlight" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Border x:Name="Card" Width="330" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel>
        <DockPanel><TextBlock x:Name="Counter" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{DynamicResource Loc.tutorial.title}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
        <TextBlock x:Name="StepTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0"><TextBlock x:Name="StepBody" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/></ScrollViewer>
        <TextBlock x:Name="Condition" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="PreviousButton" Content="{DynamicResource Loc.tutorial.previous}" Click="PreviousClick" Padding="8,4" MinHeight="30" Margin="0,0,6,4"/><Button x:Name="NextButton" Content="{DynamicResource Loc.tutorial.next}" Click="NextClick" Style="{StaticResource PrimaryButton}" Padding="8,4" MinHeight="30" Margin="0,0,6,4"/><Button Content="{DynamicResource Loc.tutorial.skip}" Click="SkipClick" Padding="8,4" MinHeight="30" Margin="0,0,0,4"/></WrapPanel>
      </StackPanel>
    </Border>
  </Canvas>
</UserControl>
