<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="clr-namespace:CaptionForge.Desktop.Guidance" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.ConfigurationOptionsPanel">
  <Border Style="{StaticResource Panel}">
    <ScrollViewer x:Name="OptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" AutomationProperties.Name="{DynamicResource Loc.ui.configuracionConDesplazamientoIndependiente}">
      <StackPanel>
        <TextBlock Text="{DynamicResource Loc.ui.configuracion}" Style="{StaticResource Section}"/>
        <TextBlock Text="{DynamicResource Loc.ui.plantillaDelProyecto}" Style="{StaticResource Label}" Margin="0,0,0,7"/>
        <c:TemplatePicker g:TutorialTarget.Id="template.choose"/>
        <Button Content="{DynamicResource Loc.ui.volverACargarLaTimeline}" Command="{Binding ReloadTimeline}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6"/>
        <TextBlock Text="{DynamicResource Loc.ui.modeloWhisper}" Style="{StaticResource Label}"/>
        <DockPanel g:TutorialTarget.Id="whisper.options">
          <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseModel}" Margin="8,0,0,0" ToolTip="{DynamicResource Loc.ui.seleccionarArchivoGgml}"/>
          <TextBox Text="{Binding ModelPath,UpdateSourceTrigger=LostFocus}" ToolTip="{DynamicResource Loc.ui.modeloWhisperGgmlBin}" AutomationProperties.Name="{DynamicResource Loc.ui.modeloWhisper}"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Loc.ui.idiomaDeTranscripcion}" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage,Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource Loc.ui.idiomaDeTranscripcion}"/>
        <TextBlock Text="{DynamicResource Loc.ui.hilosDeCpu}" Style="{StaticResource Label}"/>
        <c:CpuThreadSelector/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
