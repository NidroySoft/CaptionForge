<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.ConfigurationOptionsPanel">
  <Border Style="{StaticResource Panel}">
    <ScrollViewer x:Name="OptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" AutomationProperties.Name="Configuración con desplazamiento independiente">
      <StackPanel>
        <TextBlock Text="Configuración" Style="{StaticResource Section}"/>
        <TextBlock Text="Plantilla del proyecto" Style="{StaticResource Label}" Margin="0,0,0,7"/>
        <c:TemplatePicker/>
        <Button Content="Volver a cargar la timeline" Command="{Binding ReloadTimeline}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6"/>
        <TextBlock Text="Modelo Whisper" Style="{StaticResource Label}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseModel}" Margin="8,0,0,0" ToolTip="Seleccionar archivo GGML"/>
          <TextBox Text="{Binding ModelPath,UpdateSourceTrigger=LostFocus}" ToolTip="Modelo Whisper GGML .bin" AutomationProperties.Name="Modelo Whisper"/>
        </DockPanel>
        <TextBlock Text="Idioma de transcripción" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage,Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Idioma de transcripción"/>
        <TextBlock Text="Hilos de CPU" Style="{StaticResource Label}"/>
        <c:CpuThreadSelector/>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
          <c:AppearanceSelector/>
        </Border>
        <Expander Header="Carpetas y herramientas">
          <StackPanel>
            <TextBlock Text="Carpeta de trabajo y backups" Style="{StaticResource Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseWorkspace}" Margin="8,0,0,0"/>
              <TextBox Text="{Binding WorkspaceRoot,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Carpeta de trabajo"/>
            </DockPanel>
            <TextBlock Text="FFmpeg" Style="{StaticResource Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseFfmpeg}" Margin="8,0,0,0"/>
              <TextBox Text="{Binding FfmpegPath,UpdateSourceTrigger=LostFocus}"/>
            </DockPanel>
            <TextBlock Text="FFprobe" Style="{StaticResource Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseFfprobe}" Margin="8,0,0,0"/>
              <TextBox Text="{Binding FfprobePath,UpdateSourceTrigger=LostFocus}"/>
            </DockPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
