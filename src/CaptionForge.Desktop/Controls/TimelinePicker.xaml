<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.TimelinePicker">
  <ListBox ItemsSource="{Binding Timelines}" SelectedItem="{Binding SelectedTimeline,Mode=TwoWay}" ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="{DynamicResource Loc.ui.timelinesDelProyecto}">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <c:ResponsiveCardPanel/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <StackPanel>
          <c:CoverCard/>
          <TextBlock Text="{DynamicResource Loc.ui.fijadaEnCapcut}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" Visibility="{Binding IsPinned,Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
