<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.ProjectPicker">
  <ListBox ItemsSource="{Binding VisibleProjects}" SelectedItem="{Binding SelectedProject,Mode=TwoWay}" ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="{DynamicResource Loc.ui.proyectosDeCapcut}">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <c:ResponsiveCardPanel/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <c:CoverCard/>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
