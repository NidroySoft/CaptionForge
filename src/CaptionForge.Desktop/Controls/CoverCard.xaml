<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptionForge.Desktop.Controls.CoverCard">
  <StackPanel>
    <Border Background="{DynamicResource CoverBrush}" CornerRadius="7" Height="144">
      <Grid>
        <TextBlock Text="CC" FontSize="34" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="{Binding CoverPath,Converter={StaticResource Cover}}" Stretch="Uniform" Margin="8"/>
      </Grid>
    </Border>
    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,3" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
  </StackPanel>
</UserControl>
