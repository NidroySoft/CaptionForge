<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptionForge.Desktop.Controls.CpuThreadSelector">
  <StackPanel>
    <ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding CpuThreads,Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.ui.hilosDeCpu}"/>
    <TextBlock Text="{Binding CpuHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
