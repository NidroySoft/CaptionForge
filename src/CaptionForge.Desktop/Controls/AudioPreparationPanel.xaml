<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.AudioPreparationPanel">
  <Border Style="{StaticResource Panel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSegmentsSummary}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Text="Audio de la timeline" Style="{StaticResource Section}" FontSize="16" Margin="0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <c:AudioPlayer Grid.Row="1" Margin="0,8,0,0"/>
      <WrapPanel Grid.Row="2" Margin="0,8,0,4">
        <Button Content="Incluir todos" Command="{Binding IncludeAll}" Padding="9,4" MinHeight="28" FontSize="12" Margin="0,0,8,0"/>
        <Button Content="Excluir todos" ToolTip="Excluir sólo omite los fragmentos en esta generación. Los medios y recortes originales se conservan." Command="{Binding ExcludeAll}" Padding="9,4" MinHeight="28" FontSize="12"/>
      </WrapPanel>
      <ScrollViewer x:Name="ClipsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,5,0" AutomationProperties.Name="Lista desplazable de clips de audio">
        <c:AudioSegmentList/>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
