<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="clr-namespace:CaptionForge.Desktop.Guidance" xmlns:c="clr-namespace:CaptionForge.Desktop.Controls" x:Class="CaptionForge.Desktop.Controls.AudioPreparationPanel">
  <UserControl.Resources>
    <Style x:Key="SourceSelectionOnly" TargetType="FrameworkElement">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedSourceTrack}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource Panel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.source.refresh}"
                Command="{Binding ReloadTimeline}" ToolTip="{DynamicResource Loc.source.refreshHint}"
                Padding="9,4" MinHeight="28" FontSize="12" Margin="10,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSegmentsSummary}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Text="{DynamicResource Loc.ui.audioDeLaTimeline}" Style="{StaticResource Section}" FontSize="16" Margin="0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <StackPanel g:TutorialTarget.Id="audio.source" Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Text="{DynamicResource Loc.source.title}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding SourceTracks}"
                  SelectedItem="{Binding SelectedSourceTrack,Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding IsIdle}"
                  AutomationProperties.Name="{DynamicResource Loc.source.title}" ToolTip="{Binding SelectedSourceTrack.DisplayName}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Style="{StaticResource Muted}"
                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SourceTrackHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <Button Content="{DynamicResource Loc.preview.openDiagnostics}" Command="{Binding OpenArtifacts}"
                Visibility="{Binding HasTranscriptionDiagnostics,Converter={StaticResource BoolVisibility}}"
                ToolTip="{DynamicResource Loc.preview.diagnosticsHint}" HorizontalAlignment="Left"
                Padding="9,4" MinHeight="28" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
      <c:AudioPlayer g:TutorialTarget.Id="audio.preview" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource SourceSelectionOnly}"/>
      <WrapPanel Grid.Row="3" Margin="0,8,0,4" Style="{StaticResource SourceSelectionOnly}">
        <Button Content="{DynamicResource Loc.ui.incluirTodos}" Command="{Binding IncludeAll}" Padding="9,4" MinHeight="28" FontSize="12" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource Loc.ui.excluirTodos}" ToolTip="{DynamicResource Loc.ui.excluirSoloOmiteLosFragmentosEnEstaGeneracionLos}" Command="{Binding ExcludeAll}" Padding="9,4" MinHeight="28" FontSize="12"/>
      </WrapPanel>
      <ScrollViewer g:TutorialTarget.Id="audio.clips" x:Name="ClipsScroll" Grid.Row="4" Style="{StaticResource SourceSelectionOnly}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,5,0" AutomationProperties.Name="{DynamicResource Loc.ui.listaDesplazableDeClipsDeAudio}">
        <c:AudioSegmentList/>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
