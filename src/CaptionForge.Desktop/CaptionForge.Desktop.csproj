<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CaptionForge</AssemblyName>
    <ApplicationIcon>Resources/CaptionForge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources/CaptionForge.png" />
    <Resource Include="Resources/CaptionForge.ico" />
    <Resource Include="Resources/Palettes.json" />
    <Resource Include="Languages/es.json" />
    <Content Include="Languages/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CaptionForge.Application/CaptionForge.Application.csproj" />
    <ProjectReference Include="../CaptionForge.Infrastructure/CaptionForge.Infrastructure.csproj" />
    <ProjectReference Include="../CaptionForge.Modularity/CaptionForge.Modularity.csproj" />
  </ItemGroup>
  <Target Name="CopyInstalledModules" AfterTargets="Build;Publish">
    <ItemGroup><InstalledModuleFiles Include="../../artifacts/modules/**/*" /></ItemGroup>
    <Copy SourceFiles="@(InstalledModuleFiles)" DestinationFiles="@(InstalledModuleFiles->'$(TargetDir)Modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy Condition="'$(PublishDir)' != ''" SourceFiles="@(InstalledModuleFiles)" DestinationFiles="@(InstalledModuleFiles->'$(PublishDir)Modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
