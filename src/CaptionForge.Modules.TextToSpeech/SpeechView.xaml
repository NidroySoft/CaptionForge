<UserControl x:Class="CaptionForge.Modules.TextToSpeech.SpeechView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CaptionForge.Modules.TextToSpeech" Margin="20,12">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="SpeechBoolVisibility"/>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Border DockPanel.Dock="Right" Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,7" VerticalAlignment="Top"><TextBlock Text="LOCAL · CPU" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
   <StackPanel><TextBlock Text="Texto a voz" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Tu guion, tus voces y un audio listo para exportar." Style="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <StackPanel IsEnabled="{Binding CanEdit}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Motor" Style="{DynamicResource Label}"/><ComboBox x:Name="EngineSelector" ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Idioma" Style="{DynamicResource Label}"/><ComboBox x:Name="LanguageSelector" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      <StackPanel Grid.Column="2" Visibility="{Binding UsesPreset,Converter={StaticResource SpeechBoolVisibility}}"><TextBlock Text="Voz instalada" Style="{DynamicResource Label}"/><ComboBox x:Name="VoiceSelector" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
     </Grid>
     <Border Background="{DynamicResource RaisedBrush}" CornerRadius="7" Padding="10" Margin="0,10,0,4">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"><Button Content="Detectar instalaciones" Click="DetectInstallations" Margin="0,0,8,0"/><Button Content="Instalar motor" Click="InstallEngine"/></StackPanel>
       <TextBlock Text="{Binding InstallationStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{DynamicResource Muted}" MaxHeight="50" ToolTip="{Binding InstallationStatus}"/>
      </DockPanel>
     </Border>
     <TextBlock Text="{Binding Hint}" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
     <StackPanel Visibility="{Binding UsesReference,Converter={StaticResource SpeechBoolVisibility}}">
      <TextBlock Text="Referencia de voz · audio limpio de 6–15 segundos" Style="{DynamicResource Label}"/>
      <DockPanel><Button Content="Seleccionar audio…" Click="BrowseReference" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding ReferencePath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
     </StackPanel>
     <TextBlock Text="Texto o guion" Style="{DynamicResource Label}"/>
     <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" MaxLength="6000"/>
     <Grid Margin="0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Semilla" Style="{DynamicResource Label}"/><TextBox Text="{Binding Seed}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,16,0" Visibility="{Binding IsKokoro,Converter={StaticResource SpeechBoolVisibility}}"><TextBlock Text="Velocidad" Style="{DynamicResource Label}"/><Slider Value="{Binding Speed}" Minimum="0.7" Maximum="1.3" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding Speed,StringFormat=F2}" Style="{DynamicResource Muted}"/></StackPanel>
      <StackPanel Grid.Column="2" Visibility="{Binding IsMultilingual,Converter={StaticResource SpeechBoolVisibility}}"><TextBlock Text="Expresividad" Style="{DynamicResource Label}"/><Slider Value="{Binding Exaggeration}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/></StackPanel>
     </Grid>
    </StackPanel>
    <Expander Header="Configuración avanzada · rutas del motor y salida" IsEnabled="{Binding CanEdit}" Margin="0,6">
     <StackPanel Margin="0,8">
      <TextBlock Text="Python privado del motor" Style="{DynamicResource Label}"/><DockPanel><Button Content="Buscar…" Click="BrowsePython" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding PythonExecutable,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
      <TextBlock Text="Carpeta del modelo" Style="{DynamicResource Label}"/><DockPanel><Button Content="Buscar…" Click="BrowseModels" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding ModelDirectory,UpdateSourceTrigger=LostFocus}"/></DockPanel>
      <TextBlock Text="Carpeta para guardar los WAV" Style="{DynamicResource Label}"/><DockPanel><Button Content="Buscar…" Click="BrowseOutput" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding OutputDirectory}"/></DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,10"><Button Content="Actualizar voces" Click="RefreshVoices"/><Button Content="Guardar configuración" Click="SaveSettings" Margin="10,0,0,0"/></StackPanel>
      <TextBlock Text="La instalación automática prepara un entorno privado. No modifica el Python del equipo ni requiere configurar comandos." Style="{DynamicResource Muted}" TextWrapping="Wrap"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8" Visibility="{Binding HasOutput,Converter={StaticResource SpeechBoolVisibility}}">
     <StackPanel>
      <DockPanel><TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="00:00 / 00:00" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Tu audio" FontWeight="SemiBold"/></DockPanel>
      <local:WaveformView x:Name="Waveform" Audio="{Binding Waveform}" Height="64" Margin="0,10,0,6" AutomationProperties.Name="Forma de onda: pulsa para avanzar"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="PlayButton" Content="▶ Reproducir" Click="Play" MinWidth="120"/>
       <Slider x:Name="AudioPosition" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="PositionChanged" Margin="12,0" VerticalAlignment="Center" AutomationProperties.Name="Posición del audio"/>
       <Button Grid.Column="2" Content="■ Detener" Click="Stop"/>
      </Grid>
      <DockPanel Margin="0,10,0,0" IsEnabled="{Binding CanAdjustAudio}">
       <Button DockPanel.Dock="Left" Content="Normalizar automáticamente" Click="NormalizeAudio" ToolTip="Mide el pico del audio y ajusta su nivel a −1 dBFS, dejando margen sin saturar."/>
       <Button DockPanel.Dock="Right" Content="Original" Click="RestoreAudio" Margin="8,0,0,0"/>
       <Expander Header="Ganancia manual · experto" Margin="12,0,0,0">
        <StackPanel Margin="0,8,0,0">
         <DockPanel><Button DockPanel.Dock="Right" Content="Aplicar" Click="ApplyGain" Margin="8,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding GainDb,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Width="75" VerticalAlignment="Center"/><Slider Value="{Binding GainDb}" Minimum="-60" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" AutomationProperties.Name="Ganancia manual en decibelios" VerticalAlignment="Center"/></DockPanel>
         <TextBlock Text="Ajusta sobre el original. Una ganancia excesiva puede saturar; el resultado indica si ocurrió." Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
       </Expander>
      </DockPanel>
      <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Guardar WAV como…" Click="SaveAudio" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Abrir carpeta" Click="OpenOutputFolder"/><TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" Style="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
    </Border>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Height="5" Visibility="{Binding IsBusy,Converter={StaticResource SpeechBoolVisibility}}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="70" ToolTip="{Binding Status}" Margin="0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding IsBusy}" Margin="0,0,10,0"/><Button Content="Generar voz" Click="Generate" IsEnabled="{Binding CanGenerate}" Style="{DynamicResource PrimaryButton}"/></StackPanel>
  </StackPanel>
 </Grid>
</UserControl>
