<UserControl x:Class="CaptionForge.Modules.TextToSpeech.ReferenceAudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CaptionForge.Modules.TextToSpeech">
 <StackPanel>
  <local:WaveformView x:Name="Bars" Height="58" Margin="0,8,0,6" AutomationProperties.Name="{DynamicResource TextToSpeech.t408aff78ac6b8a22}"/>
  <Grid IsEnabled="False" x:Name="Controls">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="PlayButton" Content="▶" Width="38" ToolTip="{DynamicResource TextToSpeech.t1eafb65240b52e04}" Click="Play"/>
   <Slider x:Name="Position" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" ValueChanged="SeekSlider" AutomationProperties.Name="{DynamicResource TextToSpeech.t23c3af6c27c2a6e5}"/>
   <Button Grid.Column="2" Content="■" Width="38" ToolTip="{DynamicResource TextToSpeech.t42aefef49ee1ad39}" Click="Stop"/>
  </Grid>
  <TextBlock x:Name="Info" Text="{DynamicResource TextToSpeech.t7bd2a1a9e2ffcb24}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
 </StackPanel>
</UserControl>
